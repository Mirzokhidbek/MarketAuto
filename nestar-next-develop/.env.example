# Frontend (Next.js) — copy to .env and fill in
REACT_APP_API_URL=http://localhost:3007
REACT_APP_API_GRAPHQL_URL=http://localhost:3007/graphql
REACT_APP_API_WS=ws://localhost:3007
# server-side rendering address of the API when it differs from the public one (docker: http://api:3007/graphql)
API_INTERNAL_GRAPHQL_URL=
# public address of the site; share previews show the CarPort brand image when it is set
NEXT_PUBLIC_SITE_URL=

# support contacts shown in the footer, home page and Support page
NEXT_PUBLIC_SUPPORT_PHONE=+998 71 200 00 00
NEXT_PUBLIC_SUPPORT_EMAIL=support@marketauto.uz

# browser error tracking (https://sentry.io), optional
NEXT_PUBLIC_SENTRY_DSN=

# footer social links (an icon is shown only when its link is set)
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# company details shown in the Public Offer (/offer): legal name, INN (STIR) and address
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_INN=
NEXT_PUBLIC_LEGAL_ADDRESS=
