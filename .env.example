# Backend (apps/nestar-api, apps/nestar-batch) — copy to .env and fill in
PORT_API=3007
PORT_BATCH=3008
MONGO_DEV=mongodb://localhost:27017/nestar
MONGO_PROD=
# required; in production at least 32 random characters (e.g. `openssl rand -hex 32`)
SECRET_TOKEN=change-me-to-a-long-random-string

# production: disables the GraphQL playground, strict rate limits, no test SMS codes
NODE_ENV=development
# comma-separated list of allowed site origins (required in production; empty = allow any, development only)
CORS_ORIGINS=
# behind nginx / a load balancer, so rate limits see the real client IP
TRUST_PROXY=

# sessions: short access token + long refresh token
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# the refresh token is an httpOnly cookie. Site and API on different sites (not x.uz + api.x.uz): set none (needs https)
COOKIE_SAMESITE=lax

# SMS codes. Without these the code is only printed in the server log (development)
# Uzbek numbers (998...) — https://eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# other countries — https://twilio.com
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# email (signup and password-reset codes, security alerts). Without SMTP_HOST the email is only printed in the
# server log (development). Any SMTP works: Gmail (app password), Yandex, Mail.ru, SendGrid, Amazon SES ...
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CarPort <no-reply@carport.uz>

# USD -> UZS rate used when the Central Bank (cbu.uz) is unreachable
DEFAULT_USD_UZS=12700

# image storage: empty = local uploads/ folder; set S3_BUCKET for AWS S3 or any S3-compatible storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# error tracking (https://sentry.io), optional
SENTRY_DSN=

# docker-compose only: public addresses the browser uses
PUBLIC_API_URL=http://localhost:3007
PUBLIC_WS_URL=ws://localhost:3007
# public address of the site (sitemap, robots.txt, share previews), e.g. https://carport.uz
NEXT_PUBLIC_SITE_URL=
# company details shown in the Public Offer (/offer): legal name, INN (STIR) and address
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_INN=
NEXT_PUBLIC_LEGAL_ADDRESS=

# Firebase Authentication: ID tokens from the apps are verified against this project
FIREBASE_PROJECT_ID=

# Firebase server access (Firestore with MongoDB compatibility + Firebase Storage):
# path to the service account key from Firebase console > Project settings > Service accounts
# optional: a service account key; without it `gcloud auth application-default login` is used
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json
# images go to Firebase Storage when set, e.g. <project-id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=
# MONGO_DEV / MONGO_PROD may point to Firestore with MongoDB compatibility:
# mongodb://<database-uid>.<location>.firestore.goog:443/<database-id>?loadBalanced=true&tls=true&retryWrites=false&authMechanism=MONGODB-OIDC

# Telegram bot + Mini App
TELEGRAM_BOT_TOKEN=
# https address of the site, opened by the bot as the Mini App
TELEGRAM_WEBAPP_URL=
# Telegram user ids (comma separated) whose admin account may sign in through the Mini App
ADMIN_TELEGRAM_IDS=
