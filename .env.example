# Backend (apps/nestar-api, apps/nestar-batch) — copy to .env and fill in
PORT_API=3007
PORT_BATCH=3008
MONGO_DEV=mongodb://localhost:27017/nestar
MONGO_PROD=
SECRET_TOKEN=change-me-to-a-long-random-string

# production: disables the GraphQL playground/introspection
NODE_ENV=development
# production: comma-separated list of allowed site origins (empty = allow any, for development)
CORS_ORIGINS=
